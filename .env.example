# Copy to .env and fill in. Never commit .env.

# The Bytebase instance this server talks to (required).
BYTEBASE_URL=https://bytebase.general.aws.salla.group

# --- OAuth grant ------------------------------------------------------------
# Authentication is OAuth 2.1 only (PKCE public client, dynamic registration).
# Run `npm run auth` once per 30 days; the rotating refresh token is stored in
#   ~/.config/bytebase-mcp/token.json
# and shared by every process on this machine. Optional overrides:

# BYTEBASE_MCP_HOME=~/.config/bytebase-mcp     # token file location
# BYTEBASE_CALLBACK_PORT=51789                 # loopback OAuth redirect port

# --- Query behavior (optional) ----------------------------------------------
# BYTEBASE_ALLOW_WRITE=true        # allow write SQL through bytebase_query
#                                   # (default: read-only — use the plan tools)
# BYTEBASE_DEFAULT_LIMIT=200       # default row cap for bytebase_query
# BYTEBASE_MAX_LIMIT=5000          # hard row cap

# --- Network (optional) -------------------------------------------------------
# BYTEBASE_PROXY=https://proxy:8080   # or HTTPS_PROXY
# BYTEBASE_CA_FILE=/path/to/ca.pem    # extra CA for servers with an
#                                     # incomplete cert chain (also honors
#                                     # NODE_EXTRA_CA_CERTS)
